# =================================================================
# ENTORNO VERCEL & CONFIGURACIÓN DE ESCALABILIDAD (THE WEEKEND)
# =================================================================
# Copia estas variables a tu panel de Vercel (Project Settings > Environment Variables)

# 1. Configuración de WhatsApp de Pedidos
VITE_WHATSAPP_NUMBER=51924510006

# 2. Configuración del Headless CMS (Contentful GraphQL API)
# Obtén estas llaves de tu cuenta gratuita de Contentful (Settings > API Keys)
VITE_CONTENTFUL_SPACE_ID=tu_space_id_aqui
VITE_CONTENTFUL_ACCESS_TOKEN=tu_access_token_aqui

# 3. URL GraphQL de CMS Personalizado (Opcional si no usas Contentful)
VITE_CMS_GRAPHQL_URL=https://graphql.contentful.com/content/v1/spaces/tu_space_id_aqui

# 4. Nombre Comercial
VITE_RESTAURANT_NAME=The Weekend! Huarmey
